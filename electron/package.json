{
  "name": "mira",
  "version": "0.1.0",
  "private": true,
  "description": "Mira, a living mirror that feels your pulse. Built with the Presage SmartSpectra SDK.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild renderer.js --bundle --outfile=dist/renderer.bundle.js --platform=browser --format=iife --log-level=warning && esbuild preload.js --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.bundle.js --log-level=warning",
    "start": "npm run build && electron .",
    "start:mock": "npm run build && electron . --mock",
    "start:harness": "npm run build && electron . --harness"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "latest"
  },
  "devDependencies": {
    "electron": "^43.8.1",
    "esbuild": "^0.25.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
